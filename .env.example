DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash-command sync to one guild while developing (faster sync).
# Leave blank to sync globally (can take up to an hour to propagate).
DEV_GUILD_ID=

# Optional: when true, the bot uses a fake ESPN client and simulates a short
# scripted match (kick-off, a goal, half-time, full-time in ~90s) as soon as
# an accumulator slot is filled - no real ESPN calls, no real data touched.
# See the "Test mode" section in README.md.
TEST_MODE=false

# Optional: set to true to show odds (from https://the-odds-api.com) in
# /acc set summaries, and fill in a free-tier API key below. Off by default
# - while false, odds are simply shown as unavailable everywhere and no
# odds API calls are made at all.
ODDS_ENABLED=false
ODDS_API_KEY=
